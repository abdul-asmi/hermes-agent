[Unit]
Description=Hermes Agent container
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/hermes
ExecStartPre=-/usr/bin/docker rm -f hermes
ExecStart=/usr/bin/docker run -d --name hermes \
  --restart unless-stopped \
  --network host \
  --env HERMES_DASHBOARD=1 \
  --env HERMES_DASHBOARD_HOST=127.0.0.1 \
  --env HERMES_DASHBOARD_PORT=9119 \
  --env HERMES_GATEWAY_BOOTSTRAP_STATE=running \
  --mount type=bind,src=/srv/hermes/data,dst=/opt/data \
  --log-driver json-file \
  --log-opt max-size=20m \
  --log-opt max-file=5 \
  hermes-agent-custom gateway run
ExecStop=/usr/bin/docker stop -t 45 hermes
TimeoutStartSec=900
TimeoutStopSec=60
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
